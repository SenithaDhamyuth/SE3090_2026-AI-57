@baseUrl = http://localhost:5087
@studentToken = replace-with-student-jwt

### Request a six-digit password change code
POST {{baseUrl}}/api/auth/password-change/request
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{}

### Verify the code and set the new password
POST {{baseUrl}}/api/auth/password-change/verify
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "code": "123456",
  "newPassword": "LongAndUniquePassword1!"
}

### Create a student (admin JWT required)
POST {{baseUrl}}/api/admin/students
Authorization: Bearer replace-with-admin-jwt
Content-Type: application/json

{
  "fullName": "Amal Perera",
  "email": "amal@example.edu",
  "initialPassword": "LongAndUniquePassword1!"
}
